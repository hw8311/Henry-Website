  "sections_structure": [
    {
      "name": "Hero",
      "elements": [
        "Headline: 'Ich baue Systeme, die denken.'",
        "Sub: 'AI System Architect | Problem Solver'",
        "Visual: Portrait with blueprint overlay lines",
        "CTA: 'Zusammenarbeit anfragen'"
      ]
    },
    {
      "name": "Positioning",
      "elements": [
        "Text-heavy editorial layout",
        "Keywords: Systemdesign, Integration, Prozessintelligenz"
      ]
    },
    {
      "name": "The Difference",
      "layout": "Grid 2x2",
      "content": [
        "Strategische KI-Architektur",
        "Automatisierte Denkprozesse",
        "Entscheidungsintelligenz",
        "Skalierbare Systemlogik"
      ]
    },
    {
      "name": "Workflow (Blueprint)",
      "visual": "Horizontal timeline or connected nodes",
      "steps": ["Analyse", "Systemmodell", "Prototyp", "Integration", "Skalierung"]
    },
