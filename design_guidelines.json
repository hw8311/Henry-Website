  "animations": {
    "library": "Framer Motion",
    "preferences": {
      "hero_entrance": "Staggered fade-up with slow duration (0.8s)",
      "scroll_reveal": "WhileInView opacity-0 to opacity-100, y-20 to y-0",
      "lines": "SVG lines drawing themselves (pathLength animation)"
    }
  },
  "universal_guidelines": {
    "do_not": [
      "Use generic AI stock photos (robots, brains)",
      "Use standard gradients (purple/blue)",
      "Center align long text",
      "Use 'Inter' for headings"
    ],
    "must_do": [
      "Use 'data-testid' on all interactive elements",
      "Ensure high contrast for accessibility",
      "Use 'sonner' for toasts"
    ]
  },
  "instructions_to_main_agent": "1. Install required packages (@phosphor-icons/react, framer-motion, sonner). 2. Setup Tailwind theme with new colors and fonts. 3. Build the 'BlueprintGrid' background component first. 4. Implement sections sequentially. 5. Ensure the 'Gold' accent is used sparingly for maximum impact."
}