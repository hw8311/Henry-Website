{
  "project_name": "Henry Wilke - AI System Architect",
  "persona": "E1 - The Anti-AI Designer",
  "theme": "dark",
  "design_philosophy": {
    "core_concept": "The Intelligent System",
    "tone": "Authoritative, Strategic, Intellectual, Premium",
    "visual_style": "Editorial Minimalism meets Blueprint Architecture",
    "key_principles": [
      "Fusion over Imitation: Mixing Magazine Editorial with Technical Blueprints",
      "Negative Space: Generous padding to create luxury",
      "Content is King: Every section tells a strategic story",
      "Contrast: Deep backgrounds vs Sharp Gold/White types"
    ]
  },
  "typography": {
    "font_family": {
      "heading": "Playfair Display, serif",
      "body": "Inter, sans-serif",
      "mono": "JetBrains Mono, monospace"
    },
    "font_weights": {
      "heading": "400 (Regular) to 700 (Bold)",
      "body": "300 (Light) to 500 (Medium)"
    },
    "scale": {
      "display": "text-5xl md:text-7xl lg:text-8xl tracking-tight leading-[0.9]",
      "h1": "text-4xl md:text-6xl tracking-tight",
      "h2": "text-3xl md:text-5xl tracking-tight",
      "h3": "text-2xl md:text-3xl tracking-normal",
      "body_large": "text-lg md:text-xl leading-relaxed",
      "body_base": "text-base leading-relaxed",
      "label": "text-xs md:text-sm font-mono tracking-[0.2em] uppercase"
    },
    "instructions": "Import 'Playfair Display', 'Inter', and 'JetBrains Mono' from Google Fonts. Use Playfair for all major headings. Use Inter for body text. Use JetBrains Mono for small labels, tags, and technical details."
  },
  "colors": {
    "palette": {
      "background": {
        "default": "#020617",
        "secondary": "#0F172A",
        "card": "#1E293B"
      },
      "foreground": {
        "default": "#F8FAFC",
        "muted": "#94A3B8",
        "accent": "#E2E8F0"
      },
      "brand": {
        "primary": "#0F172A",
        "accent": "#D4AF37",
        "blueprint": "rgba(56, 189, 248, 0.15)"
      }
    },
    "gradients": {
      "gold_shine": "linear-gradient(135deg, #D4AF37 0%, #FDE047 50%, #D4AF37 100%)",
      "blueprint_fade": "linear-gradient(to bottom, transparent, rgba(56, 189, 248, 0.05))"
    },
    "borders": {
      "subtle": "rgba(255, 255, 255, 0.1)",
      "gold": "#D4AF37"
    }
  },
  "layout": {
    "spacing": {
      "container_padding": "p-6 md:p-12 lg:p-24",
      "section_gap": "gap-24 md:gap-32 lg:gap-40"
    },
    "grid_system": {
      "mode_a": "grid grid-cols-1 md:grid-cols-12 gap-6 md:gap-12 (The Tetris Grid)",
      "mode_b": "grid grid-cols-1 md:grid-cols-3 gap-8 (Feature Grid)"
    },
    "container": {
      "max_width": "max-w-7xl mx-auto"
    }
  },
  "ui_components": {
    "buttons": {
      "primary": "bg-[#D4AF37] text-[#020617] hover:bg-[#FDE047] rounded-none px-8 py-4 font-mono text-sm tracking-widest uppercase transition-all duration-300 hover:tracking-[0.25em]",
      "secondary": "bg-transparent border border-white/20 text-white hover:border-[#D4AF37] hover:text-[#D4AF37] rounded-none px-8 py-4 font-mono text-sm tracking-widest uppercase transition-all duration-300"
    },
    "cards": {
      "style": "bg-[#0F172A]/50 backdrop-blur-md border border-white/5 hover:border-[#D4AF37]/50 transition-all duration-500",
      "blueprint_overlay": "relative overflow-hidden before:absolute before:inset-0 before:bg-[url('https://www.transparenttextures.com/patterns/graphy.png')] before:opacity-5"
    },
    "inputs": {
      "style": "bg-transparent border-b border-white/20 focus:border-[#D4AF37] text-white px-0 py-4 rounded-none placeholder:text-white/30 focus:outline-none focus:ring-0 transition-colors font-mono"
    }
  },
